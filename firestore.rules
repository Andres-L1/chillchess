rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: check if the requesting user is an admin
    function isAdmin() {
      return request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }

    // Users collection and its subcollections (Kanban, etc.)
    match /users/{userId}/{allPaths=**} {
      // Any authenticated user can read their own data; admins can read all
      allow read: if request.auth != null && (request.auth.uid == userId || isAdmin() || request.auth.token.email == 'escuelatopchess@gmail.com');
      // Users can write their own data; admins can write any doc
      allow write: if request.auth != null && (request.auth.uid == userId || isAdmin() || request.auth.token.email == 'escuelatopchess@gmail.com');
    }

    // Subscriptions: read own, write only via server (webhook)
    match /subscriptions/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
      allow write: if false; // Only server-side webhook writes
    }

    // Admin audit logs: only admins can read/write
    match /adminLogs/{logId} {
      allow read, write: if isAdmin();
    }

    // Global Settings
    match /settings/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Feedback: Authenticated users can create; admins can read/write
    match /feedback/{feedbackId} {
      allow create: if request.auth != null;
      allow read, update, delete: if request.auth != null;
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}