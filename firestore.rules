rules_version = '2';

// Firestore Security Rules for ChillChess
// Optimized for music streaming app with artist submissions

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper Functions
    // ========================================================
    
    // Check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Check if user is admin
    function isAdmin() {
      return isAuthenticated() && 
             (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true ||
              request.auth.token.admin == true ||
              request.auth.token.isAdmin == true);
    }
    
    // Check if user owns the document
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    // Check if user is verified artist
    function isVerifiedArtist() {
      return isAuthenticated() && 
             get(/databases/$(database)/documents/artists/$(request.auth.uid)).data.verified == true;
    }
    
    // Validate required fields exist
    function hasRequiredFields(fields) {
      return request.resource.data.keys().hasAll(fields);
    }
    
    // =================================================================
    // USERS COLLECTION - User profiles and settings
    // =================================================================
    match /users/{userId} {
      // Users can read their own profile, admins can read all
      allow read: if isOwner(userId) || isAdmin();
      
      // Users can create their own profile on registration
      allow create: if isOwner(userId) && 
                       hasRequiredFields(['email', 'createdAt']);
      
      // Users can update their own profile (except isAdmin field)
      // Admins can update any profile
      allow update: if (isOwner(userId) && 
                        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['isAdmin'])) ||
                       isAdmin();
      
      // Only admins can delete users
      allow delete: if isAdmin();
      
      // Subcollection: User favorites
      match /favorites/{favoriteId} {
        allow read, write: if isOwner(userId);
      }
      
      // Subcollection: User playlists
      match /playlists/{playlistId} {
        allow read: if isOwner(userId) || 
                       (resource.data.public == true);
        allow write: if isOwner(userId);
      }
    }
    
    // =================================================================
    // ALBUMS COLLECTION - Approved music catalog
    // =================================================================
    match /albums/{albumId} {
      // Anyone can read approved albums
      allow read: if true;
      
      // Only admins can create albums
      allow create: if isAdmin() && 
                       hasRequiredFields(['title', 'artist', 'tracks', 'createdAt']);
      
      // Admins and verified artists can update their own albums
      allow update: if isAdmin() || 
                       (isVerifiedArtist() && resource.data.artistId == request.auth.uid);
      
      // Only admins can delete albums
      allow delete: if isAdmin();
    }
    
    // =================================================================
    // SUBMISSIONS COLLECTION - Pending artist uploads
    // =================================================================
    match /submissions/{submissionId} {
      // Users can read their own submissions, admins can read all
      allow read: if (isAuthenticated() && resource.data.userId == request.auth.uid) ||
                     isAdmin();
      
      // Authenticated users can create submissions
      allow create: if isAuthenticated() && 
                       request.resource.data.userId == request.auth.uid &&
                       hasRequiredFields(['title', 'artist', 'userId', 'status', 'createdAt']);
      
      // Users can update their own pending submissions
      // Admins can update any submission (for approval/rejection)
      allow update: if (isOwner(request.resource.data.userId) && 
                        resource.data.status == 'pending') ||
                       isAdmin();
      
      // Users can delete their own submissions, admins can delete any
      allow delete: if isOwner(resource.data.userId) || isAdmin();
    }
    
    // =================================================================
    // ARTISTS COLLECTION - Artist profiles and verification
    // =================================================================
    match /artists/{artistId} {
      // Anyone can read artist profiles
      allow read: if true;
      
      // Users can create their own artist profile
      allow create: if isOwner(artistId) && 
                       hasRequiredFields(['name', 'email', 'createdAt']);
      
      // Artists can update their own profile (except verified field)
      // Admins can update any profile (including verification)
      allow update: if (isOwner(artistId) && 
                        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['verified'])) ||
                       isAdmin();
      
      // Only admins can delete artist profiles
      allow delete: if isAdmin();
    }
    
    // =================================================================
    // CREATOR CATALOG - Royalty-free music for content creators
    // =================================================================
    match /creatorCatalog/{trackId} {
      // Anyone can read the creator catalog
      allow read: if true;
      
      // Only admins can add/update/delete tracks in creator catalog
      allow write, delete: if isAdmin();
    }
    
    // =================================================================
    // ANALYTICS COLLECTION - Usage statistics and metrics
    // =================================================================
    match /analytics/{docId} {
      // Only admins can read analytics
      allow read: if isAdmin();
      
      // Server can write analytics (via Firebase Admin SDK)
      // Users can increment play counts
      allow create, update: if isAuthenticated();
      
      // No one can delete analytics
      allow delete: if false;
    }
    
    // =================================================================
    // NOTIFICATIONS COLLECTION - User notifications
    // =================================================================
    match /notifications/{userId}/{notificationId} {
      // Users can read their own notifications
      allow read: if isOwner(userId);
      
      // System (authenticated requests) can create notifications
      allow create: if isAuthenticated();
      
      // Users can mark their own notifications as read/delete them
      allow update, delete: if isOwner(userId);
    }
    
    // =================================================================
    // BUG REPORTS COLLECTION - Public bug reporting
    // =================================================================
    match /bug_reports/{bugId} {
      // Anyone can read bug reports (for patch notes/transparency)
      allow read: if true;
      
      // Authenticated users can create bug reports
      allow create: if isAuthenticated() && 
                       hasRequiredFields(['title', 'description', 'status', 'createdAt']);
      
      // Only admins can update/delete bug reports
      allow update, delete: if isAdmin();
    }
    
    // =================================================================
    // PROPOSALS COLLECTION - Feature requests and roadmap
    // =================================================================
    match /proposals/{proposalId} {
      // Anyone can read proposals (public roadmap)
      allow read: if true;
      
      // Authenticated users can create proposals
      allow create: if isAuthenticated() && 
                       hasRequiredFields(['title', 'description', 'category', 'status', 'createdAt']);
      
      // Users can update their own proposals
      // Admins can update any proposal
      allow update: if (isAuthenticated() && resource.data.userId == request.auth.uid) ||
                       isAdmin();
      
      // Only admins can delete proposals
      allow delete: if isAdmin();
    }
    
    // =================================================================
    // ADMIN LOGS - System audit trail
    // =================================================================
    match /adminLogs/{logId} {
      // Only admins can read logs
      allow read: if isAdmin();
      
      // Admins can create logs
      allow create: if isAdmin();
      
      // No updates or deletes
      allow update, delete: if false;
    }
    
    // =================================================================
    // DEFAULT - Deny all other paths
    // =================================================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
