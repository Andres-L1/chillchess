rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: check if the requesting user is an admin
    function isAdmin() {
      return request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }

    // Users collection
    match /users/{userId} {
      // Any authenticated user can read their own doc; admins can read all
      allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
      // Users can write their own doc; admins can write any doc (for PRO toggle / delete)
      allow write: if request.auth != null && (request.auth.uid == userId || isAdmin());
    }

    // Subscriptions: read own, write only via server (webhook)
    match /subscriptions/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
      allow write: if false; // Only server-side webhook writes
    }

    // Admin audit logs: only admins can read/write
    match /adminLogs/{logId} {
      allow read, write: if isAdmin();
    }

    // Global Settings
    match /settings/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}