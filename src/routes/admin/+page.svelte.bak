<script lang="ts">
    import { authStore } from '$lib/stores/authStore';
    import {
        Users,
        Activity,
        Crown,
        CreditCard,
        Search,
        ShieldAlert,
        Trash2,
        Sparkles,
        ChevronLeft,
        ChevronRight,
        TrendingUp,
        UserX,
        Download,
        Copy,
        Check,
        Zap,
        Clock,
        Filter,
        X,
        MoreVertical,
        ExternalLink,
        CalendarDays,
        Activity as ActivityIcon,
        Settings,
        Bell,
        MessageSquare,
    } from 'lucide-svelte';
    import { onMount, onDestroy } from 'svelte';
    import { db } from '$lib/firebase';
    import {
        collection,
        onSnapshot,
        query,
        doc,
        updateDoc,
        deleteDoc,
        addDoc,
        setDoc,
        serverTimestamp,
        orderBy,
        limit,
        getDocs,
    } from 'firebase/firestore';
    import { addToast } from '$lib/stores/toasts';
    import { currencyStore } from '$lib/stores/currencyStore';

    // --- State ---
    let totalUsers = 0;
    let proUsers = 0;
    let freeUsers = 0;
    let newUsersThisWeek = 0;
    let itemsPerPage = 10;
    let currentPage = 1;
    let usersList: any[] = [];
    let activityFeed: any[] = [];
    let searchQuery = '';
    let statusFilter: 'all' | 'pro' | 'free' | 'admin' = 'all';
    let feedFilter: 'all' | 'PRO_GRANTED' | 'USER_DELETED' = 'all';
    let sortBy: 'email' | 'status' | 'joined' = 'email';
    let copiedId: string | null = null;
    let unsubscribeUsers: () => void;
    let unsubscribeLogs: () => void;
    let proPrice = 1;

    // New State for Advanced Features
    let selectedUsers: Set<string> = new Set();
    let selectedUserForModal: any = null;
    let sparklineData: number[] = [0, 0, 0, 0, 0, 0, 0];

    // Global Settings State
    let maintenanceMode = false;
    let globalMessageActive = false;
    let globalMessageText = '';
    let unsubscribeSettings: () => void;

    // --- Derived ---
    $: conversionRate = totalUsers > 0 ? Math.round((proUsers / totalUsers) * 100) : 0;
    $: estimatedMRR = proUsers * proPrice;

    $: filteredUsers = usersList
        .filter((u) => {
            const matchesSearch =
                (u.email || '').toLowerCase().includes(searchQuery.toLowerCase()) ||
                (u.id || '').toLowerCase().includes(searchQuery.toLowerCase());
            const matchesFilter =
                statusFilter === 'all' ||
                (statusFilter === 'pro' && u.isPro) ||
                (statusFilter === 'free' && !u.isPro && !u.isAdmin) ||
                (statusFilter === 'admin' && u.isAdmin);
            return matchesSearch && matchesFilter;
        })
        .sort((a, b) => {
            if (sortBy === 'status') {
                if (a.isAdmin !== b.isAdmin) return a.isAdmin ? -1 : 1;
                if (a.isPro !== b.isPro) return a.isPro ? -1 : 1;
                return 0;
            }
            if (sortBy === 'joined') {
                const ta = a.createdAt?.toMillis?.() || 0;
                const tb = b.createdAt?.toMillis?.() || 0;
                return tb - ta;
            }
            return (a.email || '').localeCompare(b.email || '');
        });

    $: totalPages = Math.ceil(filteredUsers.length / itemsPerPage) || 1;
    $: paginatedUsers = filteredUsers.slice(
        (currentPage - 1) * itemsPerPage,
        currentPage * itemsPerPage
    );

    $: if (searchQuery || statusFilter) currentPage = 1;

    $: filteredActivityFeed = activityFeed.filter((log) => {
        if (feedFilter === 'all') return true;
        return log.action === feedFilter;
    });

    $: allSelected =
        paginatedUsers.length > 0 && paginatedUsers.every((u) => selectedUsers.has(u.id));
    $: someSelected = selectedUsers.size > 0;

    // --- Helpers ---
    function relativeTime(ts: any): string {
        if (!ts) return 'Desconocido';
        const ms = ts?.toMillis ? ts.toMillis() : new Date(ts).getTime();
        const diff = Date.now() - ms;
        const m = Math.floor(diff / 60000);
        if (m < 1) return 'Ahora mismo';
        if (m < 60) return `hace ${m}m`;
        const h = Math.floor(m / 60);
        if (h < 24) return `hace ${h}h`;
        const d = Math.floor(h / 24);
        if (d < 30) return `hace ${d}d`;
        return `hace ${Math.floor(d / 30)}mes`;
    }

    function formatDate(ts: any): string {
        if (!ts) return 'Desconocido';
        const date = new Date(ts?.toMillis ? ts.toMillis() : ts);
        return date.toLocaleDateString('es-ES', {
            year: 'numeric',
            month: 'short',
            day: 'numeric',
            hour: '2-digit',
            minute: '2-digit',
        });
    }

    async function logAction(action: string, targetEmail: string, targetId: string) {
        try {
            await addDoc(collection(db, 'adminLogs'), {
                action,
                adminEmail: $authStore.user?.email || 'admin',
                targetEmail,
                targetId,
                timestamp: serverTimestamp(),
            });
        } catch (e) {
            console.warn('Could not write adminLog:', e);
        }
    }

    // --- Actions ---
    async function toggleUserPro(user: any) {
        try {
            const userRef = doc(db, 'users', user.id);
            await updateDoc(userRef, { isPro: !user.isPro });
            await logAction(user.isPro ? 'PRO_REMOVED' : 'PRO_GRANTED', user.email, user.id);
            addToast(`Pro ${!user.isPro ? 'activado' : 'quitado'} para ${user.email}`, 'success');
            if (selectedUserForModal && selectedUserForModal.id === user.id) {
                selectedUserForModal.isPro = !user.isPro;
            }
        } catch (e) {
            addToast('Error al actualizar usuario', 'error');
        }
    }

    async function handleDeleteUser(user: any) {
        if (!confirm(`¿Eliminar a ${user.email}? Esta acción no se puede deshacer.`)) return;
        try {
            await deleteDoc(doc(db, 'users', user.id));
            await logAction('USER_DELETED', user.email, user.id);
            addToast('Usuario eliminado', 'success');
            if (selectedUserForModal && selectedUserForModal.id === user.id) {
                selectedUserForModal = null;
            }
            selectedUsers.delete(user.id);
            selectedUsers = selectedUsers;
        } catch (e) {
            addToast('Error al eliminar usuario', 'error');
        }
    }

    async function updateGlobalSettings(field: string, value: any) {
        try {
            const settingsRef = doc(db, 'settings', 'global');
            await updateDoc(settingsRef, { [field]: value });
            addToast('Ajuste actualizado');
        } catch (error: any) {
            if (error.code === 'not-found' || error.message?.includes('No document to update')) {
                const settingsRef = doc(db, 'settings', 'global');
                await setDoc(settingsRef, { [field]: value }, { merge: true });
                addToast('Ajuste guardado');
            } else {
                addToast('Error al actualizar');
            }
        }
    }

    function copyToClipboard(text: string, id: string) {
        navigator.clipboard.writeText(text);
        copiedId = id;
        setTimeout(() => (copiedId = null), 2000);
    }

    // --- Lifecycle ---
    onMount(() => {
        const usersRef = collection(db, 'users');
        const q = query(usersRef);
        unsubscribeUsers = onSnapshot(q, (snapshot) => {
            const users = snapshot.docs.map((d) => ({ id: d.id, ...(d.data() as any) }));
            totalUsers = users.length;
            proUsers = users.filter((u) => u.isPro === true).length;
            freeUsers = totalUsers - proUsers;
            const now = Date.now();
            const oneWeekAgo = now - 7 * 24 * 60 * 60 * 1000;
            let dailyCounts = new Array(7).fill(0);
            users.forEach((u) => {
                const ts = u.createdAt?.toMillis?.();
                if (ts && ts > oneWeekAgo) {
                    const daysAgo = Math.floor((now - ts) / (24 * 60 * 60 * 1000));
                    if (daysAgo >= 0 && daysAgo < 7) dailyCounts[6 - daysAgo]++;
                }
            });
            sparklineData = dailyCounts;
            newUsersThisWeek = dailyCounts.reduce((a, b) => a + b, 0);
            usersList = users;
        });

        const logsQ = query(collection(db, 'adminLogs'), orderBy('timestamp', 'desc'), limit(50));
        unsubscribeLogs = onSnapshot(logsQ, (snapshot) => {
            activityFeed = snapshot.docs.map((d) => ({ id: d.id, ...d.data() }));
        });

        const settingsRef = doc(db, 'settings', 'global');
        unsubscribeSettings = onSnapshot(settingsRef, (snap) => {
            if (snap.exists()) {
                const data = snap.data();
                maintenanceMode = data.maintenanceMode || false;
                globalMessageActive = data.globalMessageActive || false;
                globalMessageText = data.globalMessageText || '';
            }
        });
    });

    onDestroy(() => {
        if (unsubscribeUsers) unsubscribeUsers();
        if (unsubscribeLogs) unsubscribeLogs();
        if (unsubscribeSettings) unsubscribeSettings();
    });
</script>

<svelte:head>
    <title>CONTROL | NeatPass Aesthetic</title>
</svelte:head>

<div class="min-h-screen bg-black text-white selection:bg-[#00D1FF]/30 font-sans">
    <!-- MODAL (Glassmorphism Strict) -->
    {#if selectedUserForModal}
        <div class="fixed inset-0 z-[100] flex items-center justify-center p-6">
            <button
                class="absolute inset-0 bg-black/80 backdrop-blur-xl"
                on:click={() => (selectedUserForModal = null)}
            ></button>
            <div
                class="relative glass-card !p-12 w-full max-w-xl animate-in zoom-in-95 duration-300"
            >
                <div class="flex flex-col gap-6">
                    <div class="flex items-center justify-between">
                        <div class="neat-badge bg-white/5 border border-white/10 text-white/40">
                            Detalles de Usuario
                        </div>
                        <button
                            on:click={() => (selectedUserForModal = null)}
                            class="text-white/20 hover:text-white transition-colors"
                        >
                            <X class="w-6 h-6" />
                        </button>
                    </div>

                    <div>
                        <h2 class="text-4xl font-black tracking-[-0.05em] leading-none mb-2">
                            {selectedUserForModal.email}
                        </h2>
                        <p class="text-[10px] font-black uppercase tracking-[0.2em] text-white/20">
                            {selectedUserForModal.id}
                        </p>
                    </div>

                    <div class="grid grid-cols-2 gap-4">
                        <div class="glass-card !p-6 !rounded-3xl">
                            <p
                                class="text-[10px] font-black uppercase tracking-[0.2em] text-white/20 mb-1"
                            >
                                Registrado
                            </p>
                            <p class="text-lg font-black">
                                {formatDate(selectedUserForModal.createdAt)}
                            </p>
                        </div>
                        <div class="glass-card !p-6 !rounded-3xl">
                            <p
                                class="text-[10px] font-black uppercase tracking-[0.2em] text-white/20 mb-1"
                            >
                                Plan
                            </p>
                            <p
                                class="text-lg font-black italic {selectedUserForModal.isPro
                                    ? 'text-[#00D1FF]'
                                    : 'text-white'}"
                            >
                                {selectedUserForModal.isPro ? 'PRO SUBS' : 'FREE USER'}
                            </p>
                        </div>
                    </div>

                    <div class="flex gap-4 pt-4">
                        <button
                            on:click={() => toggleUserPro(selectedUserForModal)}
                            class="flex-1 neat-button-primary"
                        >
                            {selectedUserForModal.isPro ? 'REVOCAR PRO' : 'ACTIVAR PRO'}
                        </button>
                        <button
                            on:click={() => handleDeleteUser(selectedUserForModal)}
                            class="px-8 bg-red-500/10 hover:bg-red-500/20 border border-red-500/20 text-red-500 rounded-full font-black text-[10px] tracking-widest uppercase italic"
                        >
                            <Trash2 class="w-5 h-5" />
                        </button>
                    </div>
                </div>
            </div>
        </div>
    {/if}

    <main class="max-w-[1400px] mx-auto p-6 sm:p-12 lg:p-20 space-y-24">
        <!-- HEADER (Minimalist Floating) -->
        <header
            class="flex flex-col md:flex-row items-baseline justify-between gap-8 animate-in fade-in slide-in-from-bottom-8 duration-700"
        >
            <div>
                <h1 class="text-7xl font-black tracking-[-0.07em] uppercase leading-[0.85]">
                    CONTROL<br /><span class="text-[#00D1FF] italic">CENTER.</span>
                </h1>
                <p
                    class="text-[10px] font-black uppercase tracking-[0.3em] text-white/20 mt-6 flex items-center gap-3"
                >
                    <span class="w-2 h-2 rounded-full bg-[#00D1FF] animate-pulse"></span>
                    Sincronización en tiempo real
                </p>
            </div>
            <div
                class="neat-badge bg-[#00D1FF]/10 text-[#00D1FF] border border-[#00D1FF]/20 px-6 py-3"
            >
                Admin: {$authStore.user?.email?.split('@')[0]}
            </div>
        </header>

        <!-- KPI GRID (Massive) -->
        <section class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
            <div class="glass-card !p-12 group hover:translate-y-[-10px] transition-transform">
                <p
                    class="text-[10px] font-black uppercase tracking-[0.3em] text-white/20 mb-4 italic"
                >
                    Total Usuarios
                </p>
                <div class="text-7xl font-black tracking-[-0.05em] leading-none mb-4 italic">
                    {totalUsers}
                </div>
                <div
                    class="neat-badge bg-white/5 text-white/30 border border-white/10 group-hover:text-[#00D1FF] group-hover:border-[#00D1FF]/20 transition-colors"
                >
                    Histórico
                </div>
            </div>

            <div class="glass-card !p-12 group hover:translate-y-[-10px] transition-transform">
                <p
                    class="text-[10px] font-black uppercase tracking-[0.3em] text-white/20 mb-4 italic"
                >
                    Pro Users
                </p>
                <div
                    class="text-7xl font-black tracking-[-0.05em] leading-none mb-4 italic text-[#00D1FF]"
                >
                    {proUsers}
                </div>
                <div class="flex items-center gap-2">
                    <TrendingUp class="w-4 h-4 text-[#00D1FF]" />
                    <span class="text-[10px] font-black uppercase tracking-widest text-[#00D1FF]"
                        >{conversionRate}% Conv</span
                    >
                </div>
            </div>

            <div class="glass-card !p-12 group hover:translate-y-[-10px] transition-transform">
                <p
                    class="text-[10px] font-black uppercase tracking-[0.3em] text-white/20 mb-4 italic"
                >
                    Estimated MRR
                </p>
                <div class="text-7xl font-black tracking-[-0.05em] leading-none mb-4 italic">
                    {$currencyStore}{estimatedMRR}
                </div>
                <div
                    class="neat-badge bg-emerald-500/10 text-emerald-500 border border-emerald-500/20"
                >
                    Ingresos / Mes
                </div>
            </div>

            <div
                class="glass-card !p-12 relative overflow-hidden group hover:translate-y-[-10px] transition-transform"
            >
                <p
                    class="text-[10px] font-black uppercase tracking-[0.3em] text-white/20 mb-4 italic"
                >
                    New (7d)
                </p>
                <div class="text-7xl font-black tracking-[-0.05em] leading-none mb-4 italic">
                    +{newUsersThisWeek}
                </div>
                <div class="absolute bottom-0 left-0 right-0 h-2 bg-[#00D1FF]/5">
                    <div
                        class="h-full bg-[#00D1FF]/20"
                        style="width: {Math.min((newUsersThisWeek / totalUsers || 0) * 100, 100)}%;"
                    ></div>
                </div>
            </div>
        </section>

        <!-- SYSTEM SETTINGS (Apple Style) -->
        <section class="grid grid-cols-1 lg:grid-cols-2 gap-12">
            <div class="glass-card !p-12">
                <div class="flex items-center justify-between mb-10">
                    <div>
                        <h3 class="text-2xl font-black tracking-tight italic uppercase mb-1">
                            Mantenimiento
                        </h3>
                        <p class="text-[10px] font-black uppercase tracking-[0.2em] text-white/20">
                            Estado Global
                        </p>
                    </div>
                    <button
                        on:click={() => updateGlobalSettings('maintenanceMode', !maintenanceMode)}
                        class="w-16 h-8 rounded-full border border-white/10 relative transition-all {maintenanceMode
                            ? 'bg-[#00D1FF]/20 border-[#00D1FF]/50'
                            : 'bg-white/5'}"
                    >
                        <div
                            class="absolute top-1 left-1 w-6 h-6 rounded-full transition-all {maintenanceMode
                                ? 'translate-x-[32px] bg-[#00D1FF]'
                                : 'bg-white/20'}"
                        ></div>
                    </button>
                </div>
                <p class="text-sm text-white/40 leading-relaxed font-bold italic">
                    Restringe el acceso a la plataforma para todos los usuarios no administradores.
                    Ideal para despliegues complejos.
                </p>
            </div>

            <div class="glass-card !p-12">
                <div class="flex items-center gap-6 mb-10">
                    <div class="p-4 bg-[#00D1FF]/10 rounded-2xl border border-[#00D1FF]/20">
                        <Bell class="w-6 h-6 text-[#00D1FF]" />
                    </div>
                    <div>
                        <h3 class="text-2xl font-black tracking-tight italic uppercase mb-1">
                            Banner Global
                        </h3>
                        <p class="text-[10px] font-black uppercase tracking-[0.2em] text-white/20">
                            Comunicación
                        </p>
                    </div>
                </div>
                <div class="flex gap-4">
                    <input
                        type="text"
                        bind:value={globalMessageText}
                        class="flex-1 bg-white/5 border border-white/10 rounded-2xl px-6 py-4 font-bold text-white placeholder-white/10 focus:outline-none focus:border-[#00D1FF]/30 transition-all uppercase text-xs tracking-widest"
                        placeholder="TEXTO DEL AVISO..."
                    />
                    <button
                        on:click={() =>
                            updateGlobalSettings('globalMessageText', globalMessageText)}
                        class="neat-button-primary !py-4 !px-8 !text-xs italic"
                    >
                        PUBLICAR
                    </button>
                </div>
            </div>
        </section>

        <!-- USER LISTING (Premium) -->
        <section class="space-y-12 pb-24">
            <div class="flex flex-col md:flex-row items-baseline justify-between gap-6">
                <div>
                    <h2
                        class="text-5xl font-black tracking-[-0.06em] uppercase italic leading-none"
                    >
                        Gestión
                    </h2>
                    <p
                        class="text-[10px] font-black uppercase tracking-[0.3em] text-white/20 mt-4 italic"
                    >
                        Directorio Maestro de Usuarios
                    </p>
                </div>
                <div class="relative w-full md:w-96">
                    <input
                        type="text"
                        bind:value={searchQuery}
                        class="w-full bg-white/5 border border-white/10 rounded-full px-8 py-4 font-bold text-white placeholder-white/20 focus:outline-none focus:border-[#00D1FF]/30 transition-all"
                        placeholder="Buscar por email o ID..."
                    />
                    <Search
                        class="absolute right-6 top-1/2 -translate-y-1/2 w-5 h-5 text-white/20"
                    />
                </div>
            </div>

            <div class="glass-card !p-0 !rounded-[3rem] overflow-hidden border-white/[0.03]">
                <div
                    class="hidden lg:grid grid-cols-12 gap-4 px-12 py-8 bg-white/[0.02] border-b border-white/[0.05]"
                >
                    <div
                        class="col-span-1 text-[10px] font-black uppercase tracking-widest text-white/30 italic"
                    >
                        Avatar
                    </div>
                    <div
                        class="col-span-5 text-[10px] font-black uppercase tracking-widest text-white/30 italic"
                    >
                        Identidad
                    </div>
                    <div
                        class="col-span-3 text-[10px] font-black uppercase tracking-widest text-white/30 italic"
                    >
                        Nivel
                    </div>
                    <div
                        class="col-span-3 text-[10px] font-black uppercase tracking-widest text-white/30 italic"
                    >
                        Registrado
                    </div>
                </div>

                <div class="divide-y divide-white/[0.03]">
                    {#each paginatedUsers as user (user.id)}
                        <button
                            on:click={() => (selectedUserForModal = user)}
                            class="w-full grid lg:grid-cols-12 gap-4 px-12 py-8 items-center hover:bg-white/[0.01] transition-colors text-left group"
                        >
                            <div class="lg:col-span-1 flex justify-center lg:justify-start">
                                <div
                                    class="w-12 h-12 rounded-2xl bg-white/5 border border-white/10 flex items-center justify-center font-black text-[#00D1FF] italic text-xl group-hover:scale-110 transition-transform"
                                >
                                    {user.email[0].toUpperCase()}
                                </div>
                            </div>
                            <div class="col-span-5">
                                <p
                                    class="text-xl font-black tracking-tight group-hover:text-[#00D1FF] transition-colors"
                                >
                                    {user.email}
                                </p>
                                <p
                                    class="text-[10px] font-black uppercase tracking-widest text-white/20"
                                >
                                    {user.id}
                                </p>
                            </div>
                            <div class="col-span-3">
                                <div class="flex items-center gap-3">
                                    {#if user.isAdmin}
                                        <div
                                            class="neat-badge bg-red-500/10 text-red-500 border border-red-500/20"
                                        >
                                            System Admin
                                        </div>
                                    {:else if user.isPro}
                                        <div
                                            class="neat-badge bg-[#00D1FF]/10 text-[#00D1FF] border border-[#00D1FF]/20"
                                        >
                                            Premium Pro
                                        </div>
                                    {:else}
                                        <div
                                            class="neat-badge bg-white/5 text-white/30 border border-white/10"
                                        >
                                            Standard Free
                                        </div>
                                    {/if}
                                </div>
                            </div>
                            <div class="col-span-3 text-sm font-bold italic text-white/40">
                                {formatDate(user.createdAt)}
                            </div>
                        </button>
                    {/each}
                </div>

                <!-- PAGINATION -->
                <div
                    class="px-12 py-10 bg-white/[0.01] border-t border-white/[0.05] flex items-center justify-between"
                >
                    <p
                        class="text-[10px] font-black uppercase tracking-widest text-white/20 italic"
                    >
                        Mostrando {paginatedUsers.length} de {filteredUsers.length} usuarios
                    </p>
                    <div class="flex gap-4">
                        <button
                            on:click={() => (currentPage = Math.max(1, currentPage - 1))}
                            disabled={currentPage === 1}
                            class="neat-button-secondary !py-3 !px-6 !text-xs disabled:opacity-20"
                            >ANTERIOR</button
                        >
                        <button
                            on:click={() => (currentPage = Math.min(totalPages, currentPage + 1))}
                            disabled={currentPage === totalPages}
                            class="neat-button-secondary !py-3 !px-6 !text-xs disabled:opacity-20"
                            >SIGUIENTE</button
                        >
                    </div>
                </div>
            </div>
        </section>
    </main>
</div>
