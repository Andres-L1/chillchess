@tailwind base;
@tailwind components;
@tailwind utilities;

/* ========================================
   Global Touch & Responsive Utilities
   ======================================== */

/* Prevent double-tap zoom on interactive elements */
button, a, input, select, textarea, [role="button"] {
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
}

/* 
 * iOS Native Feel Global Enhancements 
 */
body {
    /* Prevent rubber-banding on the whole page, keep it for scrollable elements inside */
    overscroll-behavior-y: none;
    
    /* Disable long-press context menus across the app UI by default */
    -webkit-touch-callout: none;
    
    /* Disable default user text selection for UI elements to feel like a native app */
    -webkit-user-select: none;
    user-select: none;
}

/* Re-enable selection and callouts ONLY where appropriate (inputs, text blocks where we want them) */
input, textarea, [contenteditable="true"] {
    -webkit-user-select: auto;
    user-select: auto;
    -webkit-touch-callout: default;
}

/* Add select-text classes for things we explicitly want the user to be able to copy (e.g., invoices) */
.selectable-text {
    -webkit-user-select: auto;
    user-select: auto;
}

/* Minimum tap target for accessibility (44px) */
@media (pointer: coarse) {
    button, a, [role="button"] {
        min-height: 44px;
    }
}

/* Safe area padding for iOS notch devices */
.safe-bottom {
    padding-bottom: env(safe-area-inset-bottom, 0px);
}

/* Prevent iOS auto-zoom by ensuring minimum 16px font size on inputs */
@media screen and (max-width: 767px) {
    input, select, textarea {
        font-size: 16px !important;
    }
}

/* ========================================
   Scrollbar Styles
   ======================================== */
::-webkit-scrollbar { width: 6px; height: 6px; }
::-webkit-scrollbar-track { background: transparent; }
::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 4px; }
::-webkit-scrollbar-thumb:hover { background: #94a3b8; }

/* Hide scrollbar on mobile for cleaner look but keep scrolling */
@media (max-width: 767px) {
    .hide-scrollbar-mobile::-webkit-scrollbar { display: none; }
    .hide-scrollbar-mobile { -ms-overflow-style: none; scrollbar-width: none; }
}

/* ========================================
   Toast Animations
   ======================================== */
.toast-enter { transform: translateY(100%); opacity: 0; }
.toast-enter-active { transform: translateY(0); opacity: 1; transition: all 300ms ease-out; }
.toast-exit { opacity: 0; transition: opacity 200ms ease-in; }

/* ========================================
   NFC Pulse Animation
   ======================================== */
@keyframes nfcPulse {
    0% { box-shadow: 0 0 0 0 rgba(14, 165, 233, 0.4); }
    70% { box-shadow: 0 0 0 15px rgba(14, 165, 233, 0); }
    100% { box-shadow: 0 0 0 0 rgba(14, 165, 233, 0); }
}
.nfc-scanning { animation: nfcPulse 1.5s infinite; }

/* ========================================
   Responsive Table Wrapper
   ======================================== */
.table-responsive {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
}
