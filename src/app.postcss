@tailwind base;
@tailwind components;
@tailwind utilities;

@layer base {
    :root {
        --bg: #f5f7f8;
        --text: #000000;
        --border: #000000;
        --primary: #007bff;
        --muted: #64748b;
    }
    
    .dark {
        --bg: #0f1923;
        --text: #ffffff;
        --border: #000000;
        --primary: #007bff;
        --muted: #94a3b8;
    }

    body {
        @apply bg-background-light dark:bg-background-dark text-black dark:text-white font-sans antialiased;
        min-height: 100dvh;
        transition: background-color 0.3s ease, color 0.3s ease;
    }

    /* Typography */
    h1, h2, h3, h4, h5, h6 {
        @apply tracking-tighter font-black uppercase italic;
    }
}

@layer components {
    .neo-card {
        @apply border-4 border-black bg-white dark:bg-slate-900 shadow-neo transition-all;
    }
    
    .neo-card:hover {
        @apply -translate-y-1 shadow-neo-hover;
    }

    .neo-button {
        @apply px-6 py-3 border-4 border-black font-black uppercase tracking-widest shadow-neo transition-all active:translate-x-0.5 active:translate-y-0.5 active:shadow-none bg-white text-black;
    }

    .neo-button-primary {
        @apply neo-button bg-primary text-white;
    }

    /* Helper classes */
    .theme-bg { @apply bg-background-light dark:bg-background-dark; }
    .theme-text { @apply text-black dark:text-white; }
    .theme-border { @apply border-4 border-black; }
    .theme-shadow { @apply shadow-neo; }
}

@layer utilities {
    .shadow-neo {
        box-shadow: 6px 6px 0px 0px rgba(0,0,0,1);
    }
    .shadow-neo-sm {
        box-shadow: 3px 3px 0px 0px rgba(0,0,0,1);
    }
    .shadow-neo-hover {
        box-shadow: 10px 10px 0px 0px rgba(0,0,0,1);
    }
    .shadow-neo-lg {
        box-shadow: 12px 12px 0px 0px rgba(0,0,0,1);
    }
    .neo-sticker {
        @apply bg-white dark:bg-slate-800 border-2 border-black shadow-neo-sm p-1 flex items-center justify-center;
    }
}
